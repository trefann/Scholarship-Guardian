    {
      "id": "pm_yasasvi_top_class_college",
      "name": "PM YASASVI Top Class Education in College",
      "short_name": "PM YASASVI Top Class College",
      "authority": "Ministry of Social Justice and Empowerment",
      "portal": "National Scholarship Portal (NSP)",
      "target_profile": "OBC/EBC/DNT student pursuing a prescribed full-time course at a notified/eligible institution",
      "mvp_priority": "HERO",
      "match_level_logic": {
        "strong_match": "All deterministic core eligibility rules pass and no high-impact application prerequisite is unresolved.",
        "possible_match": "No deterministic blocker, but institution/slot or another high-impact condition requires confirmation.",
        "not_currently_matching": "A deterministic core eligibility rule fails."
      },
      "eligibility_rules": [
        {
          "id": "py_category",
          "field": "category",
          "operator": "IN",
          "expected_value": [
            "OBC",
            "EBC",
            "DNT"
          ],
          "classification": "DETERMINISTIC",
          "required_for_eligibility": true,
          "student_question": "What is your social category?",
          "evidence": [
            "COMMUNITY_CERTIFICATE"
          ]
        },
        {
          "id": "py_income",
          "field": "annual_family_income",
          "operator": "LTE",
          "expected_value": 250000,
          "unit": "INR",
          "classification": "DOCUMENT_DERIVED",
          "required_for_eligibility": true,
          "student_question": "What is your family's approximate annual income?",
          "evidence": [
            "INCOME_CERTIFICATE"
          ]
        },
        {
          "id": "py_course",
          "field": "course_is_prescribed_full_time",
          "operator": "EQ",
          "expected_value": true,
          "classification": "DETERMINISTIC",
          "required_for_eligibility": true,
          "student_question": "Are you enrolled in a prescribed full-time course?",
          "evidence": [
            "ADMISSION_PROOF"
          ]
        },
        {
          "id": "py_institution",
          "field": "institution_currently_notified",
          "operator": "EQ",
          "expected_value": true,
          "classification": "POTENTIAL",
          "required_for_eligibility": true,
          "student_question": "Which institution do you attend?",
          "evidence": [
            "INSTITUTION_RECORD",
            "ADMISSION_PROOF"
          ],
          "guardian_behavior": "Return ATTENTION when the current-cycle notified institution status cannot be confidently verified."
        },
        {
          "id": "py_slot",
          "field": "scheme_slot_available",
          "operator": "EQ",
          "expected_value": true,
          "classification": "UNKNOWN",
          "required_for_eligibility": false,
          "guardian_behavior": "Do not infer slot availability. Show UNKNOWN/authority-dependent."
        }
      ],
